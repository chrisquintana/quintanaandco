---
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';

interface Props {
  business: CollectionEntry<'businesses'>;
}

const { business } = Astro.props;
const { name, category, status, description, cta, website, external } = business.data;
---

<div class="p-8 border border-soft-stone flex flex-col gap-4">
  <span class="text-sm text-muted-taupe font-sans uppercase tracking-widest">{status}</span>
  <h3 class="text-2xl font-serif font-bold text-charcoal">{name}</h3>
  <p class="text-sm text-subtle-grey font-sans">{category}</p>
  <p class="text-charcoal flex-grow">{description}</p>
  <div class="mt-4">
    {external ? (
      <a href={website} target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-charcoal text-warm-white font-sans font-medium hover:bg-muted-taupe transition-colors inline-block">{cta}</a>
    ) : (
      <Button text={cta} href={`/businesses/${business.id.replace('.md', '')}`} />
    )}
  </div>
</div>
