---
const timelineItems = [
  { year: "2016", title: "A New Beginning", description: "Chris and Vianca move to Canada with their young daughter and begin building a new chapter for their family." },
  { year: "2022", title: "The First Business", description: "They launch their online business and begin building an additional source of income alongside their professional careers." },
  { year: "Today", title: "Building the Portfolio", description: "The family continues developing multiple businesses while creating greater flexibility and long-term opportunities." },
  { year: "Next Chapter", title: "Businesses → Assets → Investments", description: "Future expansion into web services and real estate." },
];
---

<div class="space-y-12 border-l-2 border-soft-stone pl-8">
  {timelineItems.map((item) => (
    <div class="relative">
      <div class="absolute -left-[41px] top-0 w-6 h-6 rounded-full bg-warm-white border-4 border-muted-taupe"></div>
      <span class="text-sm font-sans font-bold text-muted-taupe tracking-widest uppercase">{item.year}</span>
      <h3 class="text-2xl font-serif font-bold text-charcoal mt-2">{item.title}</h3>
      <p class="text-charcoal mt-2">{item.description}</p>
    </div>
  ))}
</div>
