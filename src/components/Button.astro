---
interface Props {
  text: string;
  variant?: 'primary' | 'secondary';
  href?: string;
}

const { text, variant = 'primary', href } = Astro.props;
const className = `px-6 py-3 font-sans font-medium transition-colors ${
  variant === 'primary' 
    ? 'bg-charcoal text-warm-white hover:bg-muted-taupe' 
    : 'border border-muted-taupe text-charcoal hover:bg-ivory'
}`;
---

{href ? (
  <a href={href} class={className}>{text}</a>
) : (
  <button class={className}>{text}</button>
)}
