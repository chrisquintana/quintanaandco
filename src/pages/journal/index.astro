---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allPosts = await getCollection('journal');
---

<Layout>
  <section class="py-24 px-8">
    <h1 class="text-5xl font-serif font-bold text-charcoal mb-12 text-center">Journal</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {allPosts.map((post) => (
        <a href={`/journal/${post.id.replace('.md', '')}`} class="p-8 border border-soft-stone block hover:bg-ivory transition-colors">
          <h3 class="text-2xl font-serif font-bold text-charcoal mb-2">{post.data.title}</h3>
          <p class="text-muted-taupe text-sm font-sans mb-4">{post.data.date.toLocaleDateString()} • {post.data.category}</p>
          <p class="text-charcoal">{post.data.excerpt}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
